{
  "tcp": {
    "enabled": true,
    "syn_port_threshold": 20,
    "observation_window_seconds": 60,
    "excluded_sources": []
  },
  "udp": {
    "enabled": true,
    "port_diversity_threshold": 15,
    "observation_window_seconds": 60,
    "excluded_sources": []
  },
  "icmp": {
    "enabled": true,
    "echo_request_threshold": 50,
    "observation_window_seconds": 30,
    "excluded_sources": []
  },
  "arp": {
    "enabled": true,
    "mapping_expiry_seconds": 300,
    "trusted_mappings": {},
    "max_table_size": 1024
  },
  "dns": {
    "enabled": true,
    "query_rate_threshold": 100,
    "observation_window_seconds": 60,
    "nxdomain_threshold": 20,
    "nxdomain_window_seconds": 60,
    "excluded_sources": []
  },
  "baseline": {
    "enabled": true,
    "learning_duration_seconds": 300,
    "baseline_file": "data/baseline.json",
    "anomaly_multiplier": 2.0
  },
  "output": {
    "alerts_dir": "alerts",
    "reports_dir": "reports",
    "logs_dir": "logs",
    "data_dir": "data",
    "max_alerts_in_memory": 10000,
    "alert_suppression_window_seconds": 60,
    "generate_report_on_exit": true
  },
  "logging": {
    "level": "INFO",
    "log_to_file": true,
    "log_filename": "logs/netsentinel.log"
  },
  "local_networks": []
}
